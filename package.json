{
  "name": "changewatch-pro",
  "version": "1.2.0",
  "private": true,
  "description": "Website change monitoring, evidence snapshots, numeric extraction, diffs and alerts.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "smoke": "node scripts/live-smoke.js",
    "migrate:sqlite": "node scripts/migrate-json-to-sqlite.js",
    "backup:sqlite": "node scripts/backup-sqlite.js",
    "check": "node scripts/check.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "playwright": "1.51.1"
  },
  "allowScripts": {
    "better-sqlite3@12.9.0": true
  }
}
