# Server
PORT=3000
NODE_ENV=development
TZ=Asia/Kolkata
MAX_CONCURRENT_JOBS=2

# REQUIRED in production to protect the dashboard/API
CW_AUTH_USER=change-me
CW_AUTH_PASSWORD=replace-with-a-long-random-password

# Optional SMTP email alerts and daily digests
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
